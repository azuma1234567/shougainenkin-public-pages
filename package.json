    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.4",
    "node-html-parser": "^9.0.3",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3"
