    "verify:yougo": "node scripts/verify-yougo.mjs",
    "verify:gokai": "node scripts/verify-gokai.mjs",
    "verify:kingaku": "node --import ./scripts/lib/ts-alias.mjs scripts/verify-kingaku.mjs",
    "verify:mitate": "node --import ./scripts/lib/ts-alias.mjs scripts/verify-mitate/verify.mjs",
    "verify:mitate:print": "node scripts/verify-mitate/print.mjs",
    "verify:shorui": "node --import ./scripts/lib/ts-alias.mjs scripts/verify-shorui/verify.mjs",
    "verify:shorui:print": "node scripts/verify-shorui/print.mjs",
